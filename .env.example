# Somente credenciais locais de laboratório. Gere API_SECRET com: openssl rand -hex 32
API_SECRET=replace_with_at_least_64_hex_characters_before_starting
API_TOKEN_TTL=3600
API_ALLOWED_ORIGINS=http://localhost:5173
ELASTIC_URL=https://elasticsearch:9200
ELASTIC_CA_CERTS=/etc/elasticsearch/certs/ca.crt
REDIS_PASSWORD=replace_with_a_long_random_redis_password
REDIS_URL=redis://default:replace_with_a_long_random_redis_password@redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
LDAP_HOST=ldap://openldap:389
LDAP_BASE_DN=dc=example,dc=org
LDAP_USER_DN=cn=admin,dc=example,dc=org
LDAP_PASSWORD=admin_dev_password_change_me
LDAP_USER_BASE=ou=people,dc=example,dc=org

# Kerberos: senha mestra apenas para inicializar o KDC local; use segredo forte.
KRB5_KDC_MASTER_PASSWORD=change_this_kdc_master_password
KAFKA_KERBEROS_SERVICE_NAME=kafka
